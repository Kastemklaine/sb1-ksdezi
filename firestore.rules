rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    // Messages: read if recipient or sender or broadcast
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.toId == null ||
        resource.data.toId == request.auth.uid ||
        resource.data.fromId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in request.resource.data.readBy;
    }
    // Events: read by all authenticated, write by admin/superadmin
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
